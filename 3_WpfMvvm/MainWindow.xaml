<!-- VIEW: only layout and bindings. No x:Name, no Click handler. -->
<Window x:Class="GearCalc.WpfMvvm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GearCalc.WpfMvvm"
        Title="Gear calculator (WPF, MVVM)"
        Width="380" SizeToContent="Height">

    <!-- Connects this View to its ViewModel. All {Binding ...} below refer to MainViewModel. -->
    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Two-way binding: typing in the TextBox updates the ViewModel property immediately. -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Module m [mm]" Margin="0,0,12,8" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Module, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Number of teeth z" Margin="0,0,12,8" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Teeth, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Pressure angle [°]" Margin="0,0,12,8" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding PressureAngle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <!-- Command instead of Click: the button disables itself when CanCalculate() is false. -->
        <Button Grid.Row="3" Grid.ColumnSpan="2" Content="Calculate" Command="{Binding CalculateCommand}"
                HorizontalAlignment="Left" Padding="12,4" Margin="0,4,0,12"/>

        <!-- One-way binding: the ViewModel sets the value, the TextBlock shows it. -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Pitch diameter d" Margin="0,0,12,4"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PitchDiameter, StringFormat='{}{0:0.000} mm'}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Tip diameter da" Margin="0,0,12,4"/>
        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TipDiameter, StringFormat='{}{0:0.000} mm'}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Base diameter db" Margin="0,0,12,4"/>
        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding BaseDiameter, StringFormat='{}{0:0.000} mm'}"/>
    </Grid>
</Window>
